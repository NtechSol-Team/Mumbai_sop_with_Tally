# ─────────────────────────────────────────────────────────────────────────────
# Mumbai ERP — environment template. Copy to `.env` and fill real values.
# The root `.env` is consumed by docker-compose AND by both apps (via dotenv).
# NEVER commit the real `.env` — it is gitignored.
#
# ISOLATION RULE: every value here belongs to Mumbai ERP alone. Do NOT point
# DATABASE_URL, ports, or secrets at the original Surat Food Chain / Ganesh
# Aloopuri project. That project uses port 5432 / database `surat_food_chain`.
# Mumbai ERP uses port 5434 / database `mumbai_erp`.
# ─────────────────────────────────────────────────────────────────────────────

# ── Postgres (docker-compose) ────────────────────────────────────────────────
POSTGRES_USER=mumbai_erp
POSTGRES_PASSWORD=mumbai_erp_dev_pwd
POSTGRES_DB=mumbai_erp
POSTGRES_PORT=5434

# ── API (apps/api) ───────────────────────────────────────────────────────────
NODE_ENV=development
API_PORT=4100
# Prisma connection string — must match the Postgres vars above.
# Host port 5434, database `mumbai_erp` — NEVER 5432 / surat_food_chain.
DATABASE_URL=postgresql://mumbai_erp:mumbai_erp_dev_pwd@localhost:5434/mumbai_erp?schema=public

# JWT — generate strong random values (openssl rand -base64 48). These MUST be
# freshly generated for Mumbai ERP, never copied from another project.
JWT_ACCESS_SECRET=change_me_generate_with_openssl_rand_base64_48
JWT_REFRESH_SECRET=change_me_generate_a_different_one_openssl_rand_base64_48
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# CORS / web origin
WEB_ORIGIN=http://localhost:3100,http://localhost:3000

# GST — home state for CGST/SGST vs IGST split, and the GSTIN-lookup provider.
# 27 = Maharashtra (Mumbai). CONFIRM against the client's actual GST
# registration certificate before go-live — do not assume from the city.
HOME_STATE_CODE=27
GSTZEN_API_KEY=
GSTZEN_API_URL=https://my.gstzen.in/api/gstin-validator/

# Razorpay (test mode). Get keys from https://dashboard.razorpay.com
# Use Mumbai ERP's own account keys — never another project's.
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx
RAZORPAY_WEBHOOK_SECRET=set_this_in_razorpay_dashboard_webhook_config

# File uploads
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=20

# Caching / jobs
KPI_CACHE_TTL_SECONDS=60
MATERIALIZED_VIEW_REFRESH_CRON=*/15 * * * *

# Company letterhead (printed on invoice PDFs). Fill with the client's
# registered legal entity details before issuing any real invoice.
COMPANY_NAME=Mumbai ERP
COMPANY_TAGLINE=Mumbai ERP
COMPANY_ADDRESS=
COMPANY_PHONE=
COMPANY_GSTIN=

# ── Web (apps/web) ───────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:4100
NEXT_PUBLIC_SOCKET_URL=http://localhost:4100
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx
