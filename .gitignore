# Dependencies
node_modules/
.pnp
.pnp.js

# Environment (NEVER commit real secrets)
.env
.env.local
.env.*.local
apps/api/.env
apps/web/.env.local
.mcp.json

# Build outputs
dist/
build/
.next/
out/
*.tsbuildinfo

# electron-builder's convention is a source "build/" dir for installer icons —
# not a build *output* dir like the "build/" pattern above assumes elsewhere.
!apps/print-agent-windows/build/
!apps/print-agent-windows/build/**

# Prisma
apps/api/prisma/*.db

# Logs
logs/
*.log
npm-debug.log*

# OS / Editor
.DS_Store
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json

# Test / coverage
coverage/

# Docker volumes (if mapped locally)
.docker-data/

# Uploads (local file storage)
apps/api/uploads/*
!apps/api/uploads/.gitkeep
# Private storage — bill PDFs, never served statically
apps/api/storage/
