// ─────────────────────────────── OUTLET ORDERS ──────────────────────────────

model OutletOrder {
  id                 String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orderNumber        String             @unique @map("order_number")
  outletId           String             @map("outlet_id") @db.Uuid
  // A placed order goes straight to the fulfilment queue — there is no payment or
  // credit-approval gate before it.
  status             OutletOrderStatus  @default(CONFIRMED)
  orderDate          DateTime           @default(now()) @map("order_date") @db.Timestamptz(6)
  confirmedAt        DateTime?          @map("confirmed_at") @db.Timestamptz(6)
  // Both set at Fulfil: goods leave the godown and reach the outlet in one action.
  dispatchedAt       DateTime?          @map("dispatched_at") @db.Timestamptz(6)
  deliveredAt        DateTime?          @map("delivered_at") @db.Timestamptz(6)
  // How the outlet settled this order, once they have.
  paymentMode        OrderPaymentMode?  @map("payment_mode")
  // Razorpay order id of the in-flight/last checkout attempt (online payments only).
  razorpayOrderId    String?            @map("razorpay_order_id")
  // Where the stock was pulled from at Fulfil. Retained for historical orders;
  // fulfilment now always draws on the godown.
  fulfillmentSource  FulfillmentSource? @map("fulfillment_source")
  // Whether the resulting bill carries GST — taken from the outlet's billing
  // preference at placement, since that determines the price the outlet pays.
  isGstBill          Boolean            @default(true) @map("is_gst_bill")
  // Back-entry by the main owner for a sale that happened but never got recorded —
  // the goods already moved and the date is whatever the owner types, so these are
  // created straight as DELIVERED rather than going through the fulfilment queue.
  isManualEntry      Boolean            @default(false) @map("is_manual_entry")
  // Set at placement once the ordered quantities have been taken out of the godown.
  // NULL means stock was never deducted up-front — true of every order placed before
  // deduct-on-placement existed, so Fulfil still has to deduct those the old way and
  // Cancel must not hand back stock that was never taken. See orders.service.ts.
  stockDeductedAt    DateTime?          @map("stock_deducted_at") @db.Timestamptz(6)
  // Legacy credit-approval trail, kept so historical orders keep their audit record.
  approvedAt         DateTime?          @map("approved_at") @db.Timestamptz(6)
  approvedById       String?            @map("approved_by") @db.Uuid
  cancelledAt        DateTime?          @map("cancelled_at") @db.Timestamptz(6)
  cancelledById      String?            @map("cancelled_by") @db.Uuid
  cancellationReason String?            @map("cancellation_reason")
  notes              String?
  isDeleted          Boolean            @default(false) @map("is_deleted")
  createdAt          DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdById        String?            @map("created_by") @db.Uuid

  outlet   Outlet            @relation(fields: [outletId], references: [id])
  items    OutletOrderItem[]
  bill     Bill?
  // Advance payments taken before this order was fulfilled.
  payments Payment[]
  stockMovements StockMovement[]

  @@index([outletId, status])
  @@index([status, orderDate])
  @@map("outlet_orders")
}

model OutletOrderItem {
  id                String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orderId           String   @map("order_id") @db.Uuid
  productId         String   @map("product_id") @db.Uuid
  requestedQuantity Decimal  @map("requested_quantity") @db.Decimal(12, 4)
  confirmedQuantity Decimal? @map("confirmed_quantity") @db.Decimal(12, 4)
  unitPriceSnapshot Decimal? @map("unit_price_snapshot") @db.Decimal(12, 2)
  isDeleted         Boolean  @default(false) @map("is_deleted")
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  order   OutletOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product     @relation(fields: [productId], references: [id])

  @@index([orderId])
  @@index([productId])
  @@map("outlet_order_items")
}

// ─────────────────────────────── BILLING ────────────────────────────────────

model Bill {
  id          String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  billNumber  String     @unique @map("bill_number") // BL-2025-00142
  outletId    String     @map("outlet_id") @db.Uuid
  orderId     String?    @unique @map("order_id") @db.Uuid
  billDate    DateTime   @default(now()) @map("bill_date") @db.Timestamptz(6)
  dueDate     DateTime   @map("due_date") @db.Timestamptz(6)
  subTotal    Decimal    @map("sub_total") @db.Decimal(12, 2)
  taxTotal    Decimal    @map("tax_total") @db.Decimal(12, 2)
  // Packing, transport and similar dispatch costs the main owner adds on top of the
  // goods — kept out of subTotal/taxTotal so per-item GST math is untouched, but
  // folded into grandTotal so the outlet's balance actually reflects them. Zero for
  // every bill that doesn't carry any (i.e. every bill before this feature existed).
  otherChargesTotal Decimal @default(0) @map("other_charges_total") @db.Decimal(12, 2)
  grandTotal  Decimal    @map("grand_total") @db.Decimal(12, 2)
  amountPaid  Decimal    @default(0) @map("amount_paid") @db.Decimal(12, 2)
  balanceDue  Decimal    @map("balance_due") @db.Decimal(12, 2)
  status      BillStatus @default(UNPAID)
  // Whether this invoice carries GST — set from the order at confirmation.
  isGstBill   Boolean    @default(true) @map("is_gst_bill")
  pdfUrl      String?    @map("pdf_url")
  lockedAt    DateTime?  @map("locked_at") @db.Timestamptz(6)
  isDeleted   Boolean    @default(false) @map("is_deleted")
  createdAt   DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime   @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdById String?    @map("created_by") @db.Uuid

  outlet   Outlet       @relation(fields: [outletId], references: [id])
  order    OutletOrder? @relation(fields: [orderId], references: [id])
  items    BillItem[]
  charges  BillCharge[]
  payments Payment[]

  @@index([outletId, status])
  @@index([status, dueDate])
  @@index([billDate])
  @@map("bills")
}

model BillItem {
  id                  String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  billId              String    @map("bill_id") @db.Uuid
  productId           String    @map("product_id") @db.Uuid
  productNameSnapshot String    @map("product_name_snapshot")
  quantity            Decimal   @db.Decimal(12, 4)
  rate                Decimal   @db.Decimal(12, 2)
  taxPercent          Decimal   @map("tax_percent") @db.Decimal(5, 2)
  taxAmount           Decimal   @map("tax_amount") @db.Decimal(12, 2)
  lineTotal           Decimal   @map("line_total") @db.Decimal(12, 2)
  lockedAt            DateTime? @map("locked_at") @db.Timestamptz(6)
  isDeleted           Boolean   @default(false) @map("is_deleted")
  createdAt           DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  bill    Bill    @relation(fields: [billId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])

  @@index([billId])
  @@index([productId])
  @@map("bill_items")
}

// One-off costs the main owner adds when raising a bill — packing, transport,
// loading and the like. Free-text label rather than a fixed enum: what a dispatch
// actually costs for varies by shipment, and there's no closed list worth maintaining.
model BillCharge {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  billId    String   @map("bill_id") @db.Uuid
  label     String
  amount    Decimal  @db.Decimal(12, 2)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  bill Bill @relation(fields: [billId], references: [id], onDelete: Cascade)

  @@index([billId])
  @@map("bill_charges")
}

// A manual correction to cash-in-hand — the opening balance when the Cash Book
// starts being used, or a later correction after a physical count found a
// shortage/surplus that no recorded receipt/expense/payment explains. Positive
// adds cash, negative removes it. Deliberately not tied to any other record —
// unlike everything else the Cash Book pulls together, an adjustment IS the
// primary record of itself.
model CashAdjustment {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  amount         Decimal  @db.Decimal(12, 2)
  adjustmentDate DateTime @map("adjustment_date") @db.Timestamptz(6)
  reason         String
  isDeleted      Boolean  @default(false) @map("is_deleted")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdById    String?  @map("created_by") @db.Uuid

  @@index([adjustmentDate])
  @@map("cash_adjustments")
}

model BillAudit {
  id          String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  billId      String      @map("bill_id") @db.Uuid
  action      AuditAction
  oldValue    Json?       @map("old_value")
  newValue    Json?       @map("new_value")
  changedById String?     @map("changed_by") @db.Uuid
  changedAt   DateTime    @default(now()) @map("changed_at") @db.Timestamptz(6)

  @@index([billId])
  @@index([changedAt])
  @@map("bill_audit")
}

// ─────────────────────────────── PAYMENTS (insert-only) ─────────────────────

model Payment {
  id                String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  paymentNumber     String         @unique @map("payment_number")
  billId            String?        @map("bill_id") @db.Uuid
  // Set when an outlet pays for an order before it is fulfilled: the bill does not
  // exist yet, so the money is held against the order and applied to the bill the
  // moment Fulfil raises it (at which point billId is filled in too).
  orderId           String?        @map("order_id") @db.Uuid
  outletId          String         @map("outlet_id") @db.Uuid
  channel           PaymentChannel
  method            PaymentMethod
  amount            Decimal        @db.Decimal(12, 2)
  paymentDate       DateTime       @default(now()) @map("payment_date") @db.Timestamptz(6)
  receivedById      String?        @map("received_by") @db.Uuid
  razorpayOrderId   String?        @map("razorpay_order_id")
  razorpayPaymentId String?        @map("razorpay_payment_id")
  razorpaySignature String?        @map("razorpay_signature")
  status            PaymentStatus  @default(SUCCESS)
  notes             String?
  /// The bank's own UTR/transaction reference, for a payment nothing here confirmed
  /// automatically (UPI-QR, bank transfer) — lets the person recording it cross-check
  /// against the bank statement later instead of matching on amount and date alone.
  referenceNumber   String?        @map("reference_number")
  receiptPhotoUrl   String?        @map("receipt_photo_url")
  isDeleted         Boolean        @default(false) @map("is_deleted")
  createdAt         DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdById       String?        @map("created_by") @db.Uuid

  bill   Bill?        @relation(fields: [billId], references: [id])
  order  OutletOrder? @relation(fields: [orderId], references: [id])
  outlet Outlet       @relation(fields: [outletId], references: [id])

  @@index([billId])
  @@index([orderId])
  @@index([outletId, paymentDate])
  @@index([razorpayPaymentId])
  @@index([status])
  @@map("payments")
}

model PaymentAudit {
  id          String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  paymentId   String      @map("payment_id") @db.Uuid
  action      AuditAction
  oldValue    Json?       @map("old_value")
  newValue    Json?       @map("new_value")
