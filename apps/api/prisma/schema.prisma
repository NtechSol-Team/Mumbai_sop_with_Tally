  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  product Product @relation(fields: [productId], references: [id])

  @@map("godown_stock")
}

model MainBranchStock {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  productId String   @unique @map("product_id") @db.Uuid
  quantity  Decimal  @default(0) @db.Decimal(12, 4)
  isDeleted Boolean  @default(false) @map("is_deleted")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  product Product @relation(fields: [productId], references: [id])

  @@map("main_branch_stock")
}

model OutletStock {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  outletId  String   @map("outlet_id") @db.Uuid
  productId String   @map("product_id") @db.Uuid
  quantity  Decimal  @default(0) @db.Decimal(12, 4)
  isDeleted Boolean  @default(false) @map("is_deleted")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  outlet  Outlet  @relation(fields: [outletId], references: [id])
  product Product @relation(fields: [productId], references: [id])

  @@unique([outletId, productId])
  @@index([outletId])
  @@index([productId])
  @@map("outlet_stock")
}

// Why a godown quantity moved. Reversals carry the opposite sign of what they undo.
enum StockMovementReason {
  ORDER_PLACED
  ORDER_CANCELLED
  ORDER_FULFILLED
}

// Append-only history of godown stock changes driven by outlet orders.
//
// Godown stock is otherwise a bare running total with no trail, so this is what
// answers "why is this product down 40 units today". Rows are never updated or
// deleted — a reversal is a new row with the opposite sign, so the sum of
// quantityDelta for a product always reconciles against GodownStock.quantity.
model StockMovement {
  id        String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  productId String              @map("product_id") @db.Uuid
  outletId  String?             @map("outlet_id") @db.Uuid
  orderId   String?             @map("order_id") @db.Uuid
  reason    StockMovementReason
  // Signed: negative leaves the godown, positive returns to it.
  quantityDelta Decimal         @map("quantity_delta") @db.Decimal(12, 4)
  // Godown quantity immediately after this movement, so history reads without
  // replaying every prior row.
  balanceAfter  Decimal         @map("balance_after") @db.Decimal(12, 4)
  notes         String?
  createdAt     DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  createdById   String?         @map("created_by") @db.Uuid

  product Product      @relation(fields: [productId], references: [id])
  outlet  Outlet?      @relation(fields: [outletId], references: [id])
  order   OutletOrder? @relation(fields: [orderId], references: [id])

  @@index([productId, createdAt])
  @@index([orderId])
  @@index([outletId])
  @@index([createdAt])
  @@map("stock_movements")
}

// ─────────────────────────────── STOCK TRANSFERS ────────────────────────────

model StockTransfer {
