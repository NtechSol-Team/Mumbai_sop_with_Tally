// ─────────────────────────────── EXPENSES ───────────────────────────────────

model ExpenseCategory {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name        String   @unique
  isSystem    Boolean  @default(false) @map("is_system")
  isActive    Boolean  @default(true) @map("is_active")
  isDeleted   Boolean  @default(false) @map("is_deleted")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdById String?  @map("created_by") @db.Uuid

  expenses Expense[]

  @@map("expense_categories")
}

model Expense {
  id              String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  categoryId      String          @map("category_id") @db.Uuid
  amount          Decimal         @db.Decimal(12, 2)
  expenseDate     DateTime        @map("expense_date") @db.Timestamptz(6)
  paymentMethod   PaymentMethod   @map("payment_method")
  paidTo          String?         @map("paid_to")
  // Who actually paid. Defaulted rather than nullable so every historical expense
  // reads as the company's own, which is what they all were.
  paidBy          PaidBy          @default(COMPANY) @map("paid_by")
  supplierName    String?         @map("supplier_name")
  invoiceNumber   String?         @map("invoice_number")
  location        ExpenseLocation @default(GENERAL)
  // Whose expense this is. NULL = the business's own (godown / main branch), which
  // is every expense that existed before franchises could record their own. A set
  // outletId means the branch bears the cost alone: it is invisible to the main
  // owner and excluded from company accounting and the P&L.
  outletId        String?         @map("outlet_id") @db.Uuid
  note            String?
  receiptPhotoUrl String?         @map("receipt_photo_url")
  hsnCode         String?         @map("hsn_code")
  taxRate         Decimal         @default(0) @map("tax_rate") @db.Decimal(5, 2)
  taxAmount       Decimal         @default(0) @map("tax_amount") @db.Decimal(12, 2)
  supplierBillId  String?         @map("supplier_bill_id") @db.Uuid
  isDeleted       Boolean         @default(false) @map("is_deleted")
  createdAt       DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime        @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdById     String?         @map("created_by") @db.Uuid

  category        ExpenseCategory  @relation(fields: [categoryId], references: [id])
  supplierBill    SupplierBill?    @relation(fields: [supplierBillId], references: [id])
  outlet          Outlet?          @relation(fields: [outletId], references: [id])
  payroll         Payroll?
  employeeAdvance EmployeeAdvance?

  @@index([categoryId, expenseDate])
  @@index([location, expenseDate])
  @@index([expenseDate])
  @@index([supplierBillId])
  @@index([outletId, expenseDate])
  @@index([paidBy, expenseDate])
  @@map("expenses")
}

// ─────────────────────────────── POS ────────────────────────────────────────

model PosSession {
  id            String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sessionNumber String           @unique @map("session_number")
  outletId      String?          @map("outlet_id") @db.Uuid // null = main branch POS
  openedById    String           @map("opened_by") @db.Uuid
  openedAt      DateTime         @default(now()) @map("opened_at") @db.Timestamptz(6)
  closedAt      DateTime?        @map("closed_at") @db.Timestamptz(6)
  status        PosSessionStatus @default(OPEN)
  openingCash   Decimal          @default(0) @map("opening_cash") @db.Decimal(12, 2)
  closingCash   Decimal?         @map("closing_cash") @db.Decimal(12, 2)
  totalSales    Decimal          @default(0) @map("total_sales") @db.Decimal(12, 2)
  cashCollected Decimal          @default(0) @map("cash_collected") @db.Decimal(12, 2)
  cardCollected Decimal          @default(0) @map("card_collected") @db.Decimal(12, 2)
  upiCollected  Decimal          @default(0) @map("upi_collected") @db.Decimal(12, 2)
  voidCount     Int              @default(0) @map("void_count")
  isDeleted     Boolean          @default(false) @map("is_deleted")
  createdAt     DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)

  outlet       Outlet?          @relation(fields: [outletId], references: [id])
  transactions PosTransaction[]

  @@index([outletId, status])
  @@index([status])
  @@map("pos_sessions")
}

model PosTransaction {
  id                String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  receiptNumber     String               @unique @map("receipt_number")
  sessionId         String               @map("session_id") @db.Uuid
  outletId          String?              @map("outlet_id") @db.Uuid
  status            PosTransactionStatus @default(COMPLETED)
  orderType         PosOrderType         @default(DINE_IN) @map("order_type")
  customerName      String?              @map("customer_name")
  customerPhone     String?              @map("customer_phone")
  subTotal          Decimal              @map("sub_total") @db.Decimal(12, 2)
  itemDiscount      Decimal              @default(0) @map("item_discount") @db.Decimal(12, 2)
  billDiscount      Decimal              @default(0) @map("bill_discount") @db.Decimal(12, 2)
  taxTotal          Decimal              @map("tax_total") @db.Decimal(12, 2)
  grandTotal        Decimal              @map("grand_total") @db.Decimal(12, 2)
  paymentMode       PosPaymentMode       @map("payment_mode")
  cashReceived      Decimal?             @map("cash_received") @db.Decimal(12, 2)
  changeGiven       Decimal?             @map("change_given") @db.Decimal(12, 2)
  cashAmount        Decimal              @default(0) @map("cash_amount") @db.Decimal(12, 2)
  cardAmount        Decimal              @default(0) @map("card_amount") @db.Decimal(12, 2)
  upiAmount         Decimal              @default(0) @map("upi_amount") @db.Decimal(12, 2)
  voidReason        String?              @map("void_reason")
  tokenNumber       Int?                 @map("token_number") // daily order token, resets per outlet per day
  kotStatus         KotStatus            @default(PREPARING) @map("kot_status")
  soldById          String               @map("sold_by") @db.Uuid
  soldAt            DateTime             @default(now()) @map("sold_at") @db.Timestamptz(6)
  clientUuid        String?              @unique @map("client_uuid") @db.Uuid // offline idempotency key
  syncedFromOffline Boolean              @default(false) @map("synced_from_offline")
  isDeleted         Boolean              @default(false) @map("is_deleted")
  createdAt         DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime             @updatedAt @map("updated_at") @db.Timestamptz(6)

  session PosSession           @relation(fields: [sessionId], references: [id])
  items   PosTransactionItem[]

  @@index([sessionId])
  @@index([outletId, soldAt])
  @@index([status])
  @@index([outletId, kotStatus])
  @@map("pos_transactions")
}

model PosTransactionItem {
  id                  String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  transactionId       String   @map("transaction_id") @db.Uuid
  // Exactly one source is set: menuItemId for menu-based sales (the current
  // model), productId for historical catalog-based sales made before menus
  // existed. Both are nullable and the line is self-contained via the snapshot
  // fields below, so a sale survives even if its source item is later deleted.
  productId           String?  @map("product_id") @db.Uuid
  menuItemId          String?  @map("menu_item_id") @db.Uuid
  productNameSnapshot String   @map("product_name_snapshot")
  quantity            Decimal  @db.Decimal(12, 4)
  unitPrice           Decimal  @map("unit_price") @db.Decimal(12, 2)
  discount            Decimal  @default(0) @db.Decimal(12, 2)
  taxPercent          Decimal  @map("tax_percent") @db.Decimal(5, 2)
  taxAmount           Decimal  @map("tax_amount") @db.Decimal(12, 2)
  lineTotal           Decimal  @map("line_total") @db.Decimal(12, 2)
  isDeleted           Boolean  @default(false) @map("is_deleted")
  createdAt           DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  transaction PosTransaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  product     Product?       @relation(fields: [productId], references: [id], onDelete: SetNull)
  menuItem    MenuItem?      @relation(fields: [menuItemId], references: [id], onDelete: SetNull)

  @@index([transactionId])
  @@index([productId])
  @@index([menuItemId])
  @@map("pos_transaction_items")
}

// ─────────────────────────────── ANALYTICS ──────────────────────────────────

// Periodic KPI snapshots (distinct from the SQL materialized views, which are
// created in the audit_and_views migration and refreshed by a pg-boss job).
model AnalyticsSnapshot {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  snapshotType String   @map("snapshot_type")
  snapshotDate DateTime @map("snapshot_date") @db.Date
  scope        String   @default("GLOBAL") // 'GLOBAL' or an outlet id
  data         Json
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@unique([snapshotType, snapshotDate, scope])
  @@index([snapshotType, snapshotDate])
  @@map("analytics_snapshots")
}

// Atomic per-document-type counters for human-friendly numbers
// (bills, orders, transfers, batches, payments, POS receipts, user codes).
model DocumentCounter {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  key       String   @unique // e.g. BILL, ORDER, TRANSFER, BATCH, PAYMENT, POS_RECEIPT
  value     BigInt   @default(0)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("document_counters")
}

// ─────────────────────────────── ACCOUNTS PAYABLE ───────────────────────────

// A supplier purchase bill (payable). Raw-material goods receipts and "other"
// expense lines link back to it; supplier payments settle the balance.
model SupplierBill {
  id            String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  billNumber    String             @unique @map("bill_number")
  supplierName  String?            @map("supplier_name")
  supplierGstin String?            @map("supplier_gstin")
  invoiceNumber String?            @map("invoice_number")
  billDate      DateTime           @default(now()) @map("bill_date") @db.Timestamptz(6)
  taxableAmount Decimal            @default(0) @map("taxable_amount") @db.Decimal(12, 2)
  cgst          Decimal            @default(0) @db.Decimal(12, 2)
  sgst          Decimal            @default(0) @db.Decimal(12, 2)
  igst          Decimal            @default(0) @db.Decimal(12, 2)
  taxAmount     Decimal            @default(0) @map("tax_amount") @db.Decimal(12, 2)
  // Manual adjustment folded into totalAmount below (e.g. rounding a cash bill
  // to the nearest rupee) — can be negative.
  roundOff      Decimal            @default(0) @map("round_off") @db.Decimal(12, 2)
  totalAmount   Decimal            @map("total_amount") @db.Decimal(12, 2)
  amountPaid    Decimal            @default(0) @map("amount_paid") @db.Decimal(12, 2)
  balanceDue    Decimal            @map("balance_due") @db.Decimal(12, 2)
  status        SupplierBillStatus @default(UNPAID)
  paymentMethod PaymentMethod?     @map("payment_method")
  // Credit terms: set only when the bill isn't paid in full at entry.
  creditDays    Int?               @map("credit_days")
  dueDate       DateTime?          @map("due_date") @db.Timestamptz(6)
  // Whether this purchase carries GST (unregistered/composition suppliers often don't).
  isGstBill     Boolean            @default(true) @map("is_gst_bill")
  // Who bought it. NULL = the business's own purchase, the only kind that may move
  // godown stock. A set outletId is a branch buying its own supplies: expense lines
  // only, borne by that branch alone. See Expense.outletId.
  outletId      String?            @map("outlet_id") @db.Uuid
  notes         String?
  isDeleted     Boolean            @default(false) @map("is_deleted")
  createdAt     DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdById   String?            @map("created_by") @db.Uuid

  payments     SupplierPayment[]
  intakeLines  RawMaterialIntake[]
  expenseLines Expense[]
  items        SupplierBillItem[]
  assets       Asset[]
  outlet       Outlet?             @relation(fields: [outletId], references: [id])

  @@index([status, billDate])
  @@index([supplierName])
  @@index([status, dueDate])
  @@index([outletId, billDate])
  @@map("supplier_bills")
}

// Itemized line of a supplier purchase bill (raw material / finished good / other).
model SupplierBillItem {
  id             String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  supplierBillId String           @map("supplier_bill_id") @db.Uuid
  kind           PurchaseLineKind
  refId          String?          @map("ref_id") @db.Uuid // rawMaterialId / productId / categoryId
  name           String // snapshot of the item/category name
  hsnCode        String?          @map("hsn_code")
  quantity       Decimal?         @db.Decimal(12, 4)
  unitCost       Decimal?         @map("unit_cost") @db.Decimal(12, 2)
  taxRate        Decimal          @default(0) @map("tax_rate") @db.Decimal(5, 2)
  taxableAmount  Decimal          @map("taxable_amount") @db.Decimal(12, 2)
  taxAmount      Decimal          @default(0) @map("tax_amount") @db.Decimal(12, 2)
  lineTotal      Decimal          @map("line_total") @db.Decimal(12, 2)
  /// Ticked "Is Asset?" at entry: this line went to the asset register instead of
  /// stock or expense. Kept on the item so re-opening the bill shows the tick.
  isAsset        Boolean          @default(false) @map("is_asset")
  isDeleted      Boolean          @default(false) @map("is_deleted")
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)

  bill SupplierBill @relation(fields: [supplierBillId], references: [id], onDelete: Cascade)

  @@index([supplierBillId])
  @@map("supplier_bill_items")
}

// Insert-only payment made to a supplier against a bill.
model SupplierPayment {
  id             String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  paymentNumber  String        @unique @map("payment_number")
  supplierBillId String        @map("supplier_bill_id") @db.Uuid
  amount         Decimal       @db.Decimal(12, 2)
  method         PaymentMethod
  paymentDate    DateTime      @default(now()) @map("payment_date") @db.Timestamptz(6)
  notes          String?
  paidById       String?       @map("paid_by") @db.Uuid
  isDeleted      Boolean       @default(false) @map("is_deleted")
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdById    String?       @map("created_by") @db.Uuid

  bill SupplierBill @relation(fields: [supplierBillId], references: [id])

  @@index([supplierBillId])
  @@index([paymentDate])
  @@map("supplier_payments")
}

// ─────────────────────────────── CONTACT MASTER (GST) ───────────────────────

enum ContactType {
  CUSTOMER
  SUPPLIER
  OTHER
}

model Contact {
  id                String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  type              ContactType @default(CUSTOMER)
  name              String
  gstin             String?
  legalName         String?     @map("legal_name")
  tradeName         String?     @map("trade_name")
  stateCode         String?     @map("state_code")
  stateName         String?     @map("state_name")
  address           String?
  phone             String?
  whatsapp          String?
  email             String?
  // Bank details — all optional, mainly useful for suppliers/other paid by transfer.
  bankAccountHolder String?     @map("bank_account_holder")
  bankName          String?     @map("bank_name")
  bankAccountNumber String?     @map("bank_account_number")
  bankIfsc          String?     @map("bank_ifsc")
  isActive          Boolean     @default(true) @map("is_active")
  isDeleted         Boolean     @default(false) @map("is_deleted")
  createdAt         DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime    @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdById       String?     @map("created_by") @db.Uuid

  @@index([type])
  @@index([gstin])
  @@index([name(ops: raw("gin_trgm_ops"))], type: Gin)
  @@map("contacts")
}

// ───────────────────────── DEVELOPER: service payments ───────────────────────
// Private ledger of who pays the DEVELOPER (this software's maker) for the
// service — separate from every in-app financial model above, which is all
// about money between the shop and its own suppliers/outlets/customers.
// Reachable only through the passphrase-gated /developer console.

enum DeveloperPaymentScope {
  MAIN_ADMIN
  OUTLET
}

model DeveloperPayment {
  id          String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  scope       DeveloperPaymentScope
  // Set only when scope = OUTLET. No DB relation — app-enforced, like Outlet's own
  // ownerUserId — this ledger must never gain a foreign-key dependency on outlet
  // deletion/renaming logic; it just needs the id to still work if the outlet is
  // later deactivated.
  outletId    String?               @map("outlet_id") @db.Uuid
  amount      Decimal               @db.Decimal(12, 2)
  method      PaymentMethod?        @map("payment_method")
  paidOn      DateTime              @map("paid_on") @db.Timestamptz(6)
  // Defaults to paidOn + 1 year in the service layer, but stored explicitly so a
  // non-standard term (mid-cycle signup, a discount period, etc.) can override it.
  renewalDate DateTime              @map("renewal_date") @db.Timestamptz(6)
  notes       String?
  isDeleted   Boolean               @default(false) @map("is_deleted")
  createdAt   DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime              @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdById String?               @map("created_by") @db.Uuid

  @@index([scope, outletId])
  @@index([renewalDate])
  @@map("developer_payments")
}

// ────────────────── DEVELOPER: usage & infrastructure telemetry ──────────────
// Both tables below feed the passphrase-gated /developer console only. Neither
// is written on a hot path: activity intervals are written once when a user's
// last connection closes, metric samples once per scheduled job run.

/// One continuous "online" span for a user — from their first live connection
/// to their last one closing. Deliberately NOT extra columns on UserSession:
/// that model is a JWT refresh-token/security record with its own rotation and
/// reuse-detection semantics, and one login can span many discrete online spans
/// (tab closed and reopened, wifi drop, several devices).
model UserActivityInterval {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId        String   @map("user_id") @db.Uuid
  startedAt     DateTime @map("started_at") @db.Timestamptz(6)
  endedAt       DateTime @map("ended_at") @db.Timestamptz(6)
  activeSeconds Int      @map("active_seconds")
  isDeleted     Boolean  @default(false) @map("is_deleted")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, startedAt])
  @@index([startedAt])
  @@map("user_activity_intervals")
}

/// Periodic whole-server telemetry sample (CPU load, memory, cumulative network
/// counters) for hosting-cost analysis. Pure operational time-series, so unlike
/// the business models above it has NO isDeleted: old rows are really deleted by
/// the sampling job's retention sweep, since a soft-deleted row would still
/// occupy the table and defeat the point of capping growth.
model ServerMetricSample {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  loadAvg1        Float    @map("load_avg_1")
  loadAvg5        Float    @map("load_avg_5")
  loadAvg15       Float    @map("load_avg_15")
  memUsedPct      Float    @map("mem_used_pct")
  // RAW cumulative byte counters straight from /proc/net/dev, not per-interval
  // deltas — deltas are derived by diffing consecutive rows at read time, so the
  // job needs no persisted "previous value" that would go wrong on every restart.
  // Null on non-Linux (local dev) or if the interface read fails for one run.
  netRxBytesTotal BigInt?  @map("net_rx_bytes_total")
  netTxBytesTotal BigInt?  @map("net_tx_bytes_total")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([createdAt])
  @@map("server_metric_samples")
}

/// What a developer-side cost is for. Free-text `label` carries the specifics
/// (e.g. "Claude API", "2GB droplet"); the category is what the console groups by.
enum DeveloperExpenseCategory {
  DROPLET
  DATABASE
  AI
  DOMAIN
  OTHER
}

/// A cost the DEVELOPER pays to run this service (hosting, managed database, AI
/// APIs...), netted against DeveloperPayment income to show real profit. Like
/// that model, this is developer-console-only and never visible to any in-app role.
model DeveloperExpense {
  id          String                   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  category    DeveloperExpenseCategory
  label       String?
  amount      Decimal                  @db.Decimal(12, 2)
  /// True = this amount repeats every month from `incurredOn` until `endedOn`
  /// (or forever while null). No rows are generated per month — a month's cost
  /// is derived from the span, so stopping a subscription is a single edit.
  isRecurring Boolean                  @default(false) @map("is_recurring")
  /// One-off: the date it was paid. Recurring: the month it started.
  incurredOn  DateTime                 @map("incurred_on") @db.Timestamptz(6)
  /// Recurring only — the last month it applied. Null = still running.
  endedOn     DateTime?                @map("ended_on") @db.Timestamptz(6)
  notes       String?
  isDeleted   Boolean                  @default(false) @map("is_deleted")
  createdAt   DateTime                 @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime                 @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdById String?                  @map("created_by") @db.Uuid

  @@index([category])
  @@index([incurredOn])
  @@map("developer_expenses")
}

// ─────────────────────────── ASSETS & PAYROLL ───────────────────────────────

/// Fixed-asset register. An asset arrives either manually or from a purchase line
/// ticked "Is Asset?", which diverts that line away from stock/expense so a capital
/// purchase isn't written off into the month's P&L.
model Asset {
  id             String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  assetCode      String          @unique @map("asset_code")
  name           String
  description    String?
  serialNumber   String?         @map("serial_number")
  quantity       Decimal         @default(1) @db.Decimal(12, 4)
  purchaseCost   Decimal         @map("purchase_cost") @db.Decimal(12, 2)
  purchaseDate   DateTime        @map("purchase_date") @db.Timestamptz(6)
  supplierName   String?         @map("supplier_name")
  invoiceNumber  String?         @map("invoice_number")
  location       ExpenseLocation @default(GENERAL)
  status         AssetStatus     @default(IN_USE)
  /// Set when this asset came from a purchase bill. Points at the BILL, not the bill
  /// item — item rows are hard-deleted and recreated on every bill edit, so an FK to
  /// them would take the asset with it.
  supplierBillId String?         @map("supplier_bill_id") @db.Uuid
  notes          String?
  isActive       Boolean         @default(true) @map("is_active")
  isDeleted      Boolean         @default(false) @map("is_deleted")
  createdAt      DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime        @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdById    String?         @map("created_by") @db.Uuid

  supplierBill SupplierBill? @relation(fields: [supplierBillId], references: [id])

  @@index([status])
  @@index([supplierBillId])
  @@index([isDeleted])
  @@map("assets")
}

/// A working shift employees can be assigned to. Times are plain "HH:mm" strings —
/// Prisma's @db.Time maps to a JS Date whose date half is meaningless, and the UI
/// uses <input type="time"> which speaks exactly this format.
model Shift {
  id                 String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name               String   @unique
  startTime          String   @map("start_time")
  endTime            String   @map("end_time")
  breakMinutes       Int      @default(0) @map("break_minutes")
  /// Derived from start/end minus break on save, but editable — some shifts are paid
  /// for more or fewer hours than the clock says.
  totalWorkingHours  Decimal  @map("total_working_hours") @db.Decimal(5, 2)
  /// Minutes late still counted as on time.
  graceMinutes       Int      @default(0) @map("grace_minutes")
  /// Worked below this many hours counts as a half day.
  halfDayHours       Decimal? @map("half_day_hours") @db.Decimal(5, 2)
  /// Overtime accrues only past this many hours.
  overtimeAfterHours Decimal? @map("overtime_after_hours") @db.Decimal(5, 2)
  isActive           Boolean  @default(true) @map("is_active")
  isDeleted          Boolean  @default(false) @map("is_deleted")
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdById        String?  @map("created_by") @db.Uuid

  employees Employee[]

  @@index([isDeleted])
  @@map("shifts")
}

/// Everyone on the payroll. Deliberately separate from User (a login account): most
/// staff never sign in, and User carries none of this. `userId` optionally ties an
/// employee to their login when they do have one.
model Employee {
  id             String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// Auto-generated, shown as "Employee ID". Prefix EMPL — NOT EMP, which the
  /// USER_CODE counter already mints for User.userId.
  employeeNo     String         @unique @map("employee_no")
  /// The business's own optional code for this person.
  employeeCode   String?        @map("employee_code")
  name           String
  mobile         String?
  email          String?
  dateOfBirth    DateTime?      @map("date_of_birth") @db.Timestamptz(6)
  gender         Gender?
  address        String?
  joiningDate    DateTime       @map("joining_date") @db.Timestamptz(6)
  employmentType EmploymentType @default(FULL_TIME) @map("employment_type")
  status         EmployeeStatus @default(ACTIVE)
  department     String?
  shiftId        String?        @map("shift_id") @db.Uuid
  /// Optional link to this person's login account, when they have one.
  userId         String?        @unique @map("user_id") @db.Uuid

  salaryType         SalaryType @default(MONTHLY) @map("salary_type")
  // MONTHLY
  monthlySalary      Decimal?   @map("monthly_salary") @db.Decimal(12, 2)
  basicSalary        Decimal?   @map("basic_salary") @db.Decimal(12, 2)
  allowances         Decimal?   @db.Decimal(12, 2)
  deductions         Decimal?   @db.Decimal(12, 2)
  overtimeRate       Decimal?   @map("overtime_rate") @db.Decimal(12, 2)
  // DAILY
  perDaySalary       Decimal?   @map("per_day_salary") @db.Decimal(12, 2)
  // HOURLY
  perHourSalary      Decimal?   @map("per_hour_salary") @db.Decimal(12, 2)
  // SHIFT
  shiftSalaryName    String?    @map("shift_salary_name")
  shiftDurationHours Decimal?   @map("shift_duration_hours") @db.Decimal(5, 2)
  shiftSalary        Decimal?   @map("shift_salary") @db.Decimal(12, 2)

  isActive    Boolean  @default(true) @map("is_active")
  isDeleted   Boolean  @default(false) @map("is_deleted")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdById String?  @map("created_by") @db.Uuid

  shift      Shift?            @relation(fields: [shiftId], references: [id])
  user       User?             @relation(fields: [userId], references: [id])
  attendance Attendance[]
  payroll    Payroll[]
  advances   EmployeeAdvance[]

  @@index([status])
  @@index([shiftId])
  @@index([department])
  @@index([isDeleted])
  @@map("employees")
}

/// One employee's attendance for one calendar month, entered by hand. Deliberately a
/// monthly summary rather than per-day rows: that's what the admin actually keys in
/// today, and a future biometric/QR feed can populate the same totals.
model Attendance {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  employeeId       String   @map("employee_id") @db.Uuid
  /// Calendar month this covers.
  year             Int
  month            Int
  /// Days the business actually operated this month — the divisor for monthly pay.
  totalWorkingDays Decimal  @map("total_working_days") @db.Decimal(6, 2)
  presentDays      Decimal  @default(0) @map("present_days") @db.Decimal(6, 2)
  absentDays       Decimal  @default(0) @map("absent_days") @db.Decimal(6, 2)
  halfDays         Decimal  @default(0) @map("half_days") @db.Decimal(6, 2)
  paidLeave        Decimal  @default(0) @map("paid_leave") @db.Decimal(6, 2)
  unpaidLeave      Decimal  @default(0) @map("unpaid_leave") @db.Decimal(6, 2)
  overtimeHours    Decimal  @default(0) @map("overtime_hours") @db.Decimal(8, 2)
  /// Only meaningful for hourly staff; ignored by the other structures.
  workingHours     Decimal? @map("working_hours") @db.Decimal(8, 2)
  notes            String?
  isDeleted        Boolean  @default(false) @map("is_deleted")
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdById      String?  @map("created_by") @db.Uuid

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([employeeId, year, month])
  @@index([year, month])
  @@map("attendance")
}

/// One employee's pay for one month. Every figure the calculation depended on is
/// snapshotted here — the salary structure AND the attendance — so a later pay rise or
/// attendance correction can never silently rewrite a payslip that has been issued.
model Payroll {
  id         String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  payrollNo  String @unique @map("payroll_no")
  employeeId String @map("employee_id") @db.Uuid
  year       Int
  month      Int

  // ── Snapshot: salary structure as it stood when generated ──
  salaryType    SalaryType @map("salary_type")
  monthlySalary Decimal?   @map("monthly_salary") @db.Decimal(12, 2)
  perDaySalary  Decimal?   @map("per_day_salary") @db.Decimal(12, 2)
  perHourSalary Decimal?   @map("per_hour_salary") @db.Decimal(12, 2)
  shiftSalary   Decimal?   @map("shift_salary") @db.Decimal(12, 2)
  overtimeRate  Decimal    @default(0) @map("overtime_rate") @db.Decimal(12, 2)

  // ── Snapshot: attendance the pay was computed from ──
  totalWorkingDays Decimal @map("total_working_days") @db.Decimal(6, 2)
  presentDays      Decimal @default(0) @map("present_days") @db.Decimal(6, 2)
  halfDays         Decimal @default(0) @map("half_days") @db.Decimal(6, 2)
  paidLeave        Decimal @default(0) @map("paid_leave") @db.Decimal(6, 2)
  unpaidLeave      Decimal @default(0) @map("unpaid_leave") @db.Decimal(6, 2)
  overtimeHours    Decimal @default(0) @map("overtime_hours") @db.Decimal(8, 2)
  workingHours     Decimal @default(0) @map("working_hours") @db.Decimal(8, 2)
  /// Days actually paid for: present + paid leave + half days at half weight.
  payableDays      Decimal @default(0) @map("payable_days") @db.Decimal(6, 2)

  // ── Earnings ──
  grossSalary     Decimal @map("gross_salary") @db.Decimal(12, 2)
  allowances      Decimal @default(0) @db.Decimal(12, 2)
  overtimeAmount  Decimal @default(0) @map("overtime_amount") @db.Decimal(12, 2)
  bonus           Decimal @default(0) @db.Decimal(12, 2)
  incentives      Decimal @default(0) @db.Decimal(12, 2)
  // ── Deductions ──
  deductions      Decimal @default(0) @db.Decimal(12, 2)
  advanceRecovery Decimal @default(0) @map("advance_recovery") @db.Decimal(12, 2)
  loanRecovery    Decimal @default(0) @map("loan_recovery") @db.Decimal(12, 2)

  netSalary   Decimal       @map("net_salary") @db.Decimal(12, 2)
  status      PayrollStatus @default(PENDING)
  paymentDate DateTime?     @map("payment_date") @db.Timestamptz(6)
  /// The Expense this payout booked, created only when the row is marked PAID and
  /// removed if it is reverted — that link is what keeps the P&L honest.
  expenseId   String?       @unique @map("expense_id") @db.Uuid
  notes       String?
  isDeleted   Boolean       @default(false) @map("is_deleted")
  createdAt   DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdById String?       @map("created_by") @db.Uuid

  employee          Employee               @relation(fields: [employeeId], references: [id])
  expense           Expense?               @relation(fields: [expenseId], references: [id])
  advanceRecoveries AdvanceRecoveryEntry[]

  @@unique([employeeId, year, month])
  @@index([year, month])
  @@index([status])
  @@map("payroll")
}

/// Cash handed to an employee ahead of payday. Booked as an Expense the moment it's
/// given — the money has genuinely left the business (this system is cash-basis, with
/// no separate receivables ledger) — and recovered later by reducing net salary at
/// payroll time, which books its own smaller Expense. The two together always sum to
/// exactly the gross salary paid, so nothing is double-counted or lost from the P&L.
model EmployeeAdvance {
  id              String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  advanceNo       String        @unique @map("advance_no")
  employeeId      String        @map("employee_id") @db.Uuid
  amount          Decimal       @db.Decimal(12, 2)
  amountRecovered Decimal       @default(0) @map("amount_recovered") @db.Decimal(12, 2)
  givenDate       DateTime      @map("given_date") @db.Timestamptz(6)
  paymentMethod   PaymentMethod @map("payment_method")
  status          AdvanceStatus @default(OUTSTANDING)
  notes           String?
  /// The Expense this advance booked when given — removed if the advance is deleted
  /// before anything against it is recovered, same convention as Payroll.expenseId.
  expenseId       String?       @unique @map("expense_id") @db.Uuid
  isDeleted       Boolean       @default(false) @map("is_deleted")
  createdAt       DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdById     String?       @map("created_by") @db.Uuid

  employee   Employee               @relation(fields: [employeeId], references: [id])
  expense    Expense?               @relation(fields: [expenseId], references: [id])
  recoveries AdvanceRecoveryEntry[]

  @@index([employeeId])
  @@index([status])
  @@map("employee_advances")
}

/// One payroll's contribution toward recovering one advance — an advance can be repaid
/// across several payrolls, and a payroll's single advanceRecovery figure can be split
/// across several advances (oldest first), so this is a genuine many-to-many join, not
/// a field on either side. Existing purely so markPayrollPaid/revertPayrollPayment can
/// apply and undo a recovery exactly, to the paisa, however it was split.
model AdvanceRecoveryEntry {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  advanceId String   @map("advance_id") @db.Uuid
  payrollId String   @map("payroll_id") @db.Uuid
  amount    Decimal  @db.Decimal(12, 2)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  advance EmployeeAdvance @relation(fields: [advanceId], references: [id], onDelete: Cascade)
  payroll Payroll         @relation(fields: [payrollId], references: [id], onDelete: Cascade)

  @@unique([advanceId, payrollId])
  @@map("advance_recovery_entries")
}
