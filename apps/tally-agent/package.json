{
  "name": "mumbai-erp-tally-agent",
  "productName": "Mumbai ERP Tally Sync Agent",
  "version": "1.0.0",
  "description": "Runs on the client's Tally machine. Connects OUTWARD to Mumbai ERP, pulls validated accounting vouchers, and posts them into TallyPrime's local XML-over-HTTP interface on localhost:9000. One-way, ERP → Tally.",
  "private": true,
  "main": "src/main.js",
  "author": "Mumbai ERP",
  "license": "UNLICENSED",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis"
  },
  "dependencies": {
    "auto-launch": "^5.0.6",
    "electron-store": "^8.2.0",
    "xmlbuilder2": "^3.1.1"
  },
  "devDependencies": {
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.mumbaierp.tallyagent",
    "productName": "Mumbai ERP Tally Sync Agent",
    "asar": true,
    "files": [
      "src/**/*",
      "renderer/**/*",
      "package.json"
    ],
    "directories": {
      "buildResources": "build",
      "output": "dist"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "createStartMenuShortcut": true,
      "runAfterFinish": true,
      "artifactName": "${productName}-Setup-${version}.exe"
    }
  }
}
