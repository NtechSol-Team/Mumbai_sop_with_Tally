{
  "name": "mumbai-erp-tally-agent",
  "productName": "Arthx Tally Sync Agent",
  "version": "1.1.4",
  "description": "Runs on the client's Tally machine. Connects OUTWARD to Mumbai ERP, pulls validated accounting vouchers, and posts them into TallyPrime's local XML-over-HTTP interface on localhost:9000. One-way, ERP \u2192 Tally.",
  "private": true,
  "main": "src/main.js",
  "author": "Mumbai ERP",
  "license": "UNLICENSED",
  "scripts": {
    "test": "node --test test/*.test.js",
    "start": "electron .",
    "headless": "node src/run-headless.js",
    "dist": "electron-builder --win nsis --x64 --publish never"
  },
  "dependencies": {
    "auto-launch": "^5.0.6",
    "saxes": "6.0.0",
    "xmlbuilder2": "^3.1.1"
  },
  "devDependencies": {
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.mumbaierp.tallyagent",
    "productName": "Arthx Tally Sync Agent",
    "asar": true,
    "files": [
      "src/**/*",
      "renderer/**/*",
      "package.json",
      "build/*.png"
    ],
    "directories": {
      "buildResources": "build",
      "output": "dist"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "createStartMenuShortcut": true,
      "runAfterFinish": true,
      "artifactName": "Arthx-Tally-Agent-Setup-${version}.exe",
      "createDesktopShortcut": true
    }
  }
}
